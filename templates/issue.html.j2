<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{{ issue.title }} · Weekly English</title>
<link rel="stylesheet" href="/static/style.css?v=32" />
</head>
<body data-page="index" data-issue-key="{{ issue.key }}">

{% include "_masthead.html.j2" %}

<main class="wrap">

  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span class="crumb-sep">›</span>
    <a href="/archive">Archive</a>
    <span class="crumb-sep">›</span>
    <span class="crumb-current">{{ issue.week_label }}</span>
  </nav>

  <section class="cover cover-issue">
    <div class="cover-kicker">Issue {{ issue.week_label }} · No. {{ issue.number }}</div>
    <h1 class="cover-title">{{ issue.title }}</h1>
    <div class="cover-meta">
      <span>{{ articles|length }} pieces</span>
      <span class="dot"></span>
      <span>{{ counts.B1 }} B1 · {{ counts.B2 }} B2 · {{ counts.C1 }} C1</span>
    </div>
  </section>

  <section class="toc">
    <h2 class="toc-h2">Contents</h2>
    {% set ns = namespace(n=0) %}
    {% for lvl, label in [("B1", "入门"), ("B2", "进阶"), ("C1", "高阶")] %}
    {% set group = articles | selectattr("level", "equalto", lvl) | list %}
    {% if group %}
    <div class="toc-group">
      <div class="toc-group-head">
        <span class="chip chip-{{ lvl|lower }}">{{ lvl }}</span>
        <span class="toc-group-label">{{ label }} · {{ group|length }} 篇</span>
      </div>
      <ol class="toc-list">
        {% for art in group %}
        {% set ns.n = ns.n + 1 %}
        <li class="toc-item">
          <span class="toc-no">{{ "%02d"|format(ns.n) }}</span>
          <a class="toc-link" href="/issue/{{ issue.key }}/article-{{ art.id }}.html">{{ art.title }}</a>
          <span class="toc-words">{{ art.stats.total_words }} words</span>
          <span class="toc-time">{{ art.published_display }}</span>
        </li>
        {% endfor %}
      </ol>
    </div>
    {% endif %}
    {% endfor %}
  </section>

  {% if vocab_summary %}
  <section class="vocab-summary">
    <h2 class="toc-h2">Vocabulary in this issue</h2>
    <p class="vocab-summary-help">
      Words below sit outside the 3,500-word gaokao list.
      Click one to find the pieces it appears in.
    </p>
    <div class="vocab-list">
      {% for w in vocab_summary %}
      <a class="vocab-word vocab-rare" href="/search?q={{ w.word|urlencode }}">{{ w.word }}<span class="vocab-count">{{ w.count }}</span></a>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <section class="filters" aria-label="Search and filter this issue">
    <div class="filter-row">
      <label class="search">
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="1.6"/>
          <line x1="16.5" y1="16.5" x2="21" y2="21" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
        <input type="search" id="q" placeholder="Filter this issue…" autocomplete="off" />
      </label>

      <div class="filter-group" data-filter="level">
        <button class="chip chip-level is-on" data-value="all">All</button>
        <button class="chip chip-b1" data-value="B1">B1</button>
        <button class="chip chip-b2" data-value="B2">B2</button>
        <button class="chip chip-c1" data-value="C1">C1</button>
      </div>

      <div class="filter-group" data-filter="source">
        <button class="chip chip-src is-on" data-value="all">All sources</button>
        {% for s in sources %}<button class="chip chip-src" data-value="{{ s }}">{{ s }}</button>{% endfor %}
      </div>
    </div>
    <p class="filter-status" id="status">Showing {{ articles|length }} of {{ articles|length }}</p>
  </section>

  {% for lvl, label in [("B1", "入门"), ("B2", "进阶"), ("C1", "高阶")] %}
  {% set group_cards = articles | selectattr("level", "equalto", lvl) | list %}
  {% if group_cards %}
  <section class="cards level-block lv-{{ lvl|lower }}" data-block="{{ lvl }}">
    <button class="block-head" type="button" data-toggle-block="{{ lvl }}">
      <span class="chip chip-{{ lvl|lower }}">{{ lvl }}</span>
      <span class="block-title">{{ label }}层 · {{ group_cards|length }} 篇</span>
      <span class="block-caret">▾</span>
    </button>
    <div class="block-body">
      {% for art in group_cards %}
      <a class="card card-{{ art.level|lower }}"
         href="/issue/{{ issue.key }}/article-{{ art.id }}.html"
         data-title="{{ art.title | e }}"
         data-level="{{ art.level | e }}"
         data-source="{{ art.source | e }}"
         data-body="{{ art.body_search | e }}">
        <div class="card-head">
          <span class="src">{{ art.source }}</span>
          <span class="chip chip-{{ art.level|lower }}">{{ art.level }}</span>
        </div>
        <h3 class="card-title">{{ art.title }}</h3>
        <p class="card-deck">{{ art.deck }}</p>
        <div class="card-foot">
          <span>{{ art.stats.total_words }} words</span>
          <span class="dot"></span>
          <time>{{ art.published_display }}</time>
        </div>
      </a>
      {% endfor %}
    </div>
  </section>
  {% endif %}
  {% endfor %}
  <p class="empty" id="empty" hidden>No matching articles.</p>

</main>

{% include "_footer.html.j2" %}

<script src="/static/app.js?v=40"></script>
</body>
</html>
