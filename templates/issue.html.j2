<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{{ issue.title }} · Weekly English</title>
<link rel="stylesheet" href="static/style.css" />
</head>
<body data-page="index">

<header class="masthead">
  <div class="wrap">
    <a class="brand" href="index.html">
      <span class="logo-mark">W·E</span>
      <span class="logo-text">Weekly English</span>
    </a>
    <nav class="meta">
      <span>Issue {{ issue.week_label }}</span>
      <span class="dot"></span>
      <a class="nav-link" href="archive.html">Archive</a>
      <span class="dot"></span>
      <a class="nav-link" id="account-link" href="/auth/login">Sign in</a>
    </nav>
  </div>
</header>

<main class="wrap">

  <section class="cover">
    <div class="cover-kicker">{{ issue.week_label }} · No. {{ issue.number }}</div>
    <h1 class="cover-title">{{ issue.title }}</h1>
    <div class="cover-meta">
      <span>{{ articles|length }} pieces</span>
      <span class="dot"></span>
      <span>{{ counts.B1 }} B1 · {{ counts.B2 }} B2 · {{ counts.C1 }} C1</span>
    </div>
  </section>

  <aside class="legend">
    <span class="legend-label">Vocabulary</span>
    <span class="legend-item"><span class="dot dot-rare"></span>Out-of-scope words · beyond high-school curriculum</span>
  </aside>

  <section class="filters" aria-label="Search and filter articles">
    <div class="filter-row">
      <label class="search">
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="1.6"/>
          <line x1="16.5" y1="16.5" x2="21" y2="21" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
        <input type="search" id="q" placeholder="Search title or content…" autocomplete="off" />
      </label>

      <div class="filter-group" data-filter="level">
        <button class="chip chip-level is-on" data-value="all">All</button>
        <button class="chip chip-b1" data-value="B1">B1</button>
        <button class="chip chip-b2" data-value="B2">B2</button>
        <button class="chip chip-c1" data-value="C1">C1</button>
      </div>

      <div class="filter-group" data-filter="source">
        <button class="chip chip-src is-on" data-value="all">All sources</button>
        {% for s in sources %}<button class="chip chip-src" data-value="{{ s }}">{{ s }}</button>{% endfor %}
      </div>
    </div>
    <p class="filter-status" id="status">Showing {{ articles|length }} of {{ articles|length }}</p>
  </section>

  {% for lvl, label in [("B1", "入门"), ("B2", "进阶"), ("C1", "高阶")] %}
  {% set group_cards = articles | selectattr("level", "equalto", lvl) | list %}
  {% if group_cards %}
  <section class="cards level-block lv-{{ lvl|lower }}{{ ' is-closed' if lvl != 'B2' else '' }}" data-block="{{ lvl }}">
    <button class="block-head" type="button" data-toggle-block="{{ lvl }}">
      {% if lvl == "B1" %}
      <svg class="lv-icon" viewBox="0 0 32 32" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 7 C12 4.5 7 4.5 3.5 6.5 L3.5 25 C7 23 12 23 16 25.5"/><path d="M16 7 C20 4.5 25 4.5 28.5 6.5 L28.5 25 C25 23 20 23 16 25.5"/><path d="M16 7 L16 25.5"/><path d="M6 11 C8.5 10 11 10.2 13 11.2"/><path d="M6 15 C8.5 14 11 14.2 13 15.2"/></g></svg>
      {% elif lvl == "B2" %}
      <svg class="lv-icon" viewBox="0 0 32 32" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 15.5 L29 4.5 L21 27.5 L13.5 19.5 Z"/><path d="M13.5 19.5 L29 4.5"/><path d="M13.5 19.5 L12 26 L16.5 21.5"/></g></svg>
      {% else %}
      <svg class="lv-icon" viewBox="0 0 32 32" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M27 3.5 C17 6 9.5 13 7 24.5 L5.5 27.5"/><path d="M27 3.5 C25.5 10 21.5 16.5 14.5 20 C11 21.8 8.5 22.6 7 24.5"/><path d="M27 3.5 C20 4.5 12.5 9.5 9.5 15.5 C13.5 14.5 22 10.5 27 3.5 Z"/><path d="M11 21 L8 24"/></g></svg>
      {% endif %}
      <span class="chip chip-{{ lvl|lower }}">{{ lvl }}</span>
      <span class="block-title">{{ label }}层 · {{ group_cards|length }} 篇</span>
      <span class="block-caret">▾</span>
    </button>
    <div class="block-body">
      {% for art in group_cards %}
      <a class="card card-{{ art.level|lower }}"
         href="article-{{ art.id }}.html"
         data-title="{{ art.title }}"
         data-level="{{ art.level }}"
         data-source="{{ art.source }}"
         data-body="{{ art.body_search }}">
        <div class="card-head">
          <span class="src">{{ art.source }}</span>
          <span class="chip chip-{{ art.level|lower }}">{{ art.level }}</span>
        </div>
        <h3 class="card-title">{{ art.title }}</h3>
        <p class="card-deck">{{ art.deck }}</p>
        <div class="card-foot">
          <span>{{ art.stats.total_words }} words</span>
          <span class="dot"></span>
          <time>{{ art.published_display }}</time>
        </div>
      </a>
      {% endfor %}
    </div>
  </section>
  {% endif %}
  {% endfor %}
  <p class="empty" id="empty" hidden>No matching articles.</p>
  </section>

</main>

<footer class="foot">
  <div class="wrap">
    <span>Weekly English · {{ issue.week_label }}</span>
    <span>Originals preserved verbatim.</span>
  </div>
</footer>

<script src="static/app.js"></script>
</body>
</html>