<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Flashcards · IELTS · Weekly English</title>
<link rel="stylesheet" href="{{ asset('style.css') }}" />
<link rel="stylesheet" href="{{ asset('ielts.css') }}" />
</head>
<body data-page="ielts-flashcards" data-q="{{ q }}">

{% include "_masthead.html.j2" %}

<main class="wrap">

  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span class="crumb-sep">›</span>
    <a href="/ielts">IELTS</a>
    <span class="crumb-sep">›</span>
    <span class="crumb-current">Flashcards</span>
  </nav>

  <section class="cover cover-compact ielts-cover">
    <div class="cover-kicker">IELTS Flashcards</div>
    <h1 class="cover-title">闪卡自测</h1>
    <div class="cover-meta">
      <span id="fc-status">Loading…</span>
      <span class="dot" id="fc-mastered-wrap" hidden></span>
      <span id="fc-mastered" hidden></span>
    </div>
    <p class="cover-blurb">
      每轮随机抽 {{ 20 }} 个词,看词想义、点卡片翻面核对。连续认识 3 次即视为掌握,之后不再出现在默认复习池里。
      键盘:空格翻面,1 = 不认识,2 = 认识。
    </p>
    {% if q %}
    <p class="fc-scope">正在练:<strong>{{ q }}</strong> 相关单词
      <a href="/ielts/flashcards">清除</a></p>
    {% endif %}
  </section>

  <nav class="level-switch" aria-label="IELTS pages">
    <a class="chip ielts-chip" href="/ielts/vocab">词表</a>
    <a class="chip ielts-chip is-on" href="/ielts/flashcards">闪卡自测</a>
    <a class="chip ielts-chip" href="/ielts/practice">AI 练习</a>
  </nav>

  <p class="ielts-hint" id="fc-login-hint" hidden>
    未登录:本轮进度不会保存。<a href="/auth/login">登录</a>后进度记在云端,换设备也在。
  </p>

  <section class="fc-stage" id="fc-stage">
    <div class="fc-card" id="fc-card" tabindex="0" role="button"
         aria-label="Flashcard — click or press space to flip">
      <div class="fc-face fc-front">
        <span class="fc-word" id="fc-word">…</span>
        <button class="ielts-btn fc-say" type="button" id="fc-say" title="发音">🔊</button>
        <span class="fc-hint">点击翻面 · 空格</span>
      </div>
      <div class="fc-face fc-back">
        <span class="fc-word fc-word-back" id="fc-word-back"></span>
        <span class="fc-phon" id="fc-phon"></span>
        <span class="fc-pos" id="fc-pos"></span>
        <p class="fc-trans" id="fc-trans"></p>
      </div>
    </div>

    <div class="fc-controls" id="fc-controls">
      <button class="ielts-btn fc-judge" type="button" id="fc-unknown">不认识 <kbd>1</kbd></button>
      <button class="ielts-btn fc-judge fc-good" type="button" id="fc-known">认识 <kbd>2</kbd></button>
    </div>

    <div class="fc-summary" id="fc-summary" hidden>
      <h2 class="fc-summary-title" id="fc-summary-title">本轮完成</h2>
      <p class="fc-summary-body" id="fc-summary-body"></p>
      <div class="fc-summary-actions">
        <button class="ielts-btn ielts-submit" type="button" id="fc-again">再来一轮</button>
        <button class="ielts-btn" type="button" id="fc-review-missed" hidden>复习本轮不认识的</button>
      </div>
    </div>

    <div class="fc-foot">
      <label class="fc-skip-label">
        <input type="checkbox" id="fc-include-mastered" /> 连已掌握的词一起复习
      </label>
      <label class="fc-skip-label"><input type="checkbox" id="fc-sound" checked /> 发音</label>
      <span class="fc-progress" id="fc-progress"></span>
    </div>
  </section>

</main>

{% include "_footer.html.j2" %}

<script src="{{ asset('app.js') }}"></script>
<script src="{{ asset('ielts.js') }}"></script>
</body>
</html>
