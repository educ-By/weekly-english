<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{{ article.title }} · Weekly English</title>
<link rel="stylesheet" href="/static/style.css?v=29" />
</head>
<body data-page="article" data-issue-key="{{ issue.key }}">

{% include "_masthead.html.j2" %}

<main class="wrap">

  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span class="crumb-sep">›</span>
    <a href="/archive">Archive</a>
    <span class="crumb-sep">›</span>
    <a href="/issue/{{ issue.key }}">{{ issue.week_label }}</a>
    <span class="crumb-sep">›</span>
    <span class="crumb-current">{{ article.title }}</span>
  </nav>

  <article class="entry" id="article-{{ article.id }}" data-level="{{ article.level }}">
    <div class="entry-head">
      <div class="entry-meta">
        {% if article.url %}
        <a class="src" href="{{ article.url | e }}" target="_blank" rel="noopener noreferrer">{{ article.source }}</a>
        {% else %}
        <span class="src">{{ article.source }}</span>
        {% endif %}
        <span class="chip chip-{{ article.level|lower }}">{{ article.level }} · {{ article.level_label }}</span>
        <time>{{ article.published_display }}</time>
      </div>
      <h1>{{ article.title }}</h1>
      {% if article.title_zh %}<p class="title-zh">{{ article.title_zh }}</p>{% endif %}
      <p class="stats">
        {{ article.stats.total_words }} words ·
        avg {{ article.stats.avg_sent_len }} words/sentence ·
        {{ article.stats.sentences }} sentences ·
        {{ (article.stats.coverage_b2 * 100) | round(0, 'floor') }}% B2 coverage
      </p>
    </div>

    <div class="entry-tools">
      <button class="btn play-btn" data-target="body-{{ article.id }}" data-lang="en" aria-label="Listen in English">
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"/>
          <path d="M16 8a5 5 0 0 1 0 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
        <span>Listen · English</span>
      </button>
      <button class="btn play-btn" data-target="body-{{ article.id }}" data-lang="zh" aria-label="Listen in Mandarin">
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"/>
          <path d="M16 8a5 5 0 0 1 0 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
        <span>Listen · 中文</span>
      </button>

      <label class="btn upload-btn" data-article="{{ article.id }}">
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 4v12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          <path d="M6 10l6-6 6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M4 18v2h16v-2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
        <span>Upload audio</span>
        <input type="file" accept="audio/*" hidden />
      </label>
    </div>

    <div class="entry-summary">
      <strong>Excerpt.</strong>
      {{ article.summary_paragraphs | join(' ') }}
    </div>

    <div class="entry-body" id="body-{{ article.id }}">
      {% for p in article.body_paragraphs %}
      <p>{{ p }}</p>
      {% endfor %}
    </div>

    <details class="rare-words">
      <summary>Out-of-scope vocabulary · {{ article.rare_words|length }} words</summary>
      <p class="rare-help">
        Words below are not in the standard high-school / CET-4+6 curriculum.
        Hover any highlighted word in the article for a quick gloss.
      </p>
      <div class="vocab-list">
        {% for w in article.rare_words %}
        <button class="vocab-word vocab-rare" data-word="{{ w }}">{{ w }}</button>
        {% endfor %}
      </div>
    </details>

    <div class="ask-mount"></div>
  </article>

  {% if prev_article or next_article %}
  <nav class="pager" aria-label="More in this issue">
    {% if prev_article %}
    <a class="pager-item pager-prev" href="/issue/{{ issue.key }}/article-{{ prev_article.id }}.html">
      <span class="pager-label">← Previous</span>
      <span class="pager-title">{{ prev_article.title }}</span>
    </a>
    {% else %}<span class="pager-item pager-empty"></span>{% endif %}
    {% if next_article %}
    <a class="pager-item pager-next" href="/issue/{{ issue.key }}/article-{{ next_article.id }}.html">
      <span class="pager-label">Next →</span>
      <span class="pager-title">{{ next_article.title }}</span>
    </a>
    {% else %}<span class="pager-item pager-empty"></span>{% endif %}
  </nav>
  {% endif %}

  {% if related %}
  <section class="related">
    <h2 class="related-h2">Related reading</h2>
    <p class="related-help">More from this issue — ranked by shared out-of-scope vocabulary, then by level.</p>
    <div class="related-list">
      {% for r in related %}
      <a class="related-item" href="/issue/{{ issue.key }}/article-{{ r.id }}.html">
        <span class="chip chip-{{ r.level|lower }}">{{ r.level }}</span>
        <span class="related-title">{{ r.title }}</span>
        <span class="related-shared">{{ r.shared }} shared word{{ '' if r.shared == 1 else 's' }}</span>
      </a>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <p class="back-link"><a href="/issue/{{ issue.key }}">← Back to {{ issue.week_label }}</a></p>

</main>

{% include "_footer.html.j2" %}

<script src="/static/app.js?v=36"></script>
</body>
</html>
