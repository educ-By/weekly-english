<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>My learning · Weekly English</title>
<link rel="stylesheet" href="{{ asset('style.css') }}" />
<link rel="stylesheet" href="{{ asset('ielts.css') }}" />
</head>
<body data-page="me">

{% include "_masthead.html.j2" %}

<main class="wrap">

  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span class="crumb-sep">›</span>
    <span class="crumb-current">My learning</span>
  </nav>

  <section class="cover cover-compact">
    <div class="cover-kicker">Account</div>
    <h1 class="cover-title" id="me-title">Loading…</h1>
    <div class="cover-meta" id="me-meta"></div>
  </section>

  <form class="me-name" id="me-name" hidden autocomplete="off">
    <label class="auth-row">
      <span>Display name</span>
      <input type="text" name="display_name" maxlength="24"
             placeholder="How should we call you?" autocomplete="nickname" />
    </label>
    <div class="me-name-actions">
      <button class="btn me-name-save" type="submit">Save</button>
      <button class="btn" type="button" data-cancel-name>Cancel</button>
      <p class="auth-help" id="me-name-help"></p>
    </div>
  </form>

  <section class="me-stats" id="me-stats" hidden></section>

  <div id="me-content">
    <section class="me-section">
      <h2 class="me-h2" id="me-vocab-h2">My vocabulary</h2>
      <div class="me-slot" id="me-vocab"><p class="me-empty">Loading your words…</p></div>
    </section>

    <section class="me-section">
      <h2 class="me-h2" id="me-reading-h2">Reading</h2>
      <div class="me-slot" id="me-reading"><p class="me-empty">Loading what you have read…</p></div>
    </section>

    <section class="me-section" id="me-ielts">
      <h2 class="me-h2" id="me-ielts-h2">IELTS practice</h2>
      <div class="me-slot" id="me-ielts-flash"><p class="me-empty">Loading flashcards…</p></div>
      <div class="me-slot" id="me-ielts-writing"><p class="me-empty">Loading writing feedback…</p></div>
      <div class="me-slot" id="me-ielts-speaking"><p class="me-empty">Loading speaking sessions…</p></div>
    </section>
  </div>

</main>

{% include "_footer.html.j2" %}

<script src="{{ asset('me.js') }}"></script>
</body>
</html>
