# Weekly English — environment configuration
# 复制为 .env 后填值;Render 上用 dashboard 填这些 key。

# 必填(后端 AI 用)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 必填(部署到 Render 时务必设) — JWT 签名密钥,任意长字符串
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# 数据库 — 部署到 Render 时填 Neon / 任何 Postgres 的连接串
#   例如: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# 不填则本地自动用 SQLite(适合开发)
DATABASE_URL=

# 可选:NewsAPI(只在配置启用时用到)
NEWS_API_KEY=

# 可选:The Guardian 官方 API(免费开发 key,注册: https://open-platform.theguardian.com/)
# content.guardianapis.com 国内直连可达,是 theguardian.com(RSS 被墙)的官方全文通道
# 留空即跳过 Guardian API;填 key 后自动抓 world/technology 两版块各 2 篇
GUARDIAN_API_KEY=

# Server
PORT=8000

# AI 月度 token 上限(全局共享;开发者邮箱账户不受限)
AI_MONTHLY_TOKEN_LIMIT=200000

# 发音评测(音素级)—— 讯飞开放平台「语音评测 ISE」
# 为什么是讯飞:国内平台里唯一明确不要求成年的(用户协议写明"未满18周岁请在监护人
# 陪同下…使用本平台"),实名只要身份证+人脸识别;给的是英文音节/音素级评分
# (准确度/流利度/完整度/总分),新用户约 1 万次免费额度。
# 开通:https://console.xfyun.cn 创建应用 → 语音评测 → 拿到 AppID/APIKey/APISecret
# 注意:要在控制台开通「全维度评测」权限,否则只返回总分,没有准确度/流利度/完整度
# 不填则发音评测整块不显示,口语模块退回"只评文字"的模式
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
# 篇章题型(read_chapter,可读 30-120 词)是讯飞的高阶权限,要单独申请购买。
# 不申请就别设这一项:默认只走句子模式(≤30 词),超长会提示分段 —— 否则调用直接报错。
# XFYUN_ALLOW_CHAPTER=1

# 备用发音评测:腾讯云智聆 SOE(需年满18岁实名,默认不用)
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_TOKEN=
TENCENT_SOE_SCORE_COEFF=3.0

# 发音评测月度次数上限(讯飞/腾讯共用一个计数;按次计费,与 token 不是一个量纲)
PRON_MONTHLY_LIMIT=1000