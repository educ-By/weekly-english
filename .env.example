# Weekly English — environment configuration
# 复制为 .env 后填值;Render 上用 dashboard 填这些 key。

# 必填(后端 AI 用)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 必填(部署到 Render 时务必设) — JWT 签名密钥,任意长字符串
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# 数据库 — 部署到 Render 时填 Neon / 任何 Postgres 的连接串
#   例如: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# 不填则本地自动用 SQLite(适合开发)
DATABASE_URL=

# 可选:NewsAPI(只在配置启用时用到)
NEWS_API_KEY=

# Server
PORT=8000